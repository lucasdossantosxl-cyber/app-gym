<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 ou mais novo. O banco com rotinas e treinos e as preferências entram no backup do Android
    (conta Google do aparelho) e na transferência direta para um celular novo.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
