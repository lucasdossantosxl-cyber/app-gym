<?xml version="1.0" encoding="utf-8"?>
<!-- Os treinos ficam só no aparelho: nada vai para backup em nuvem. A cópia é feita pelo próprio app em "Salvar backup". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database"/>
        <include domain="sharedpref"/>
    </device-transfer>
</data-extraction-rules>
